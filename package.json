{
  "name": "nuvexa",
  "version": "1.0.0",
  "description": "Nuvexa - Herramientas Digitales Privadas",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:pack": "vite build && npx @electron/packager . Nuvexa --platform=win32 --arch=x64 --icon=build/icon.ico --out=release --overwrite --ignore=\"(assets|scratch|\\.git)\"",
    "electron:installer": "npm run electron:pack && node scripts/build_installer.js"
  },
  "build": {
    "appId": "com.nuvexa.app",
    "productName": "Nuvexa",
    "copyright": "Copyright © 2026 Ignacio Gatti - Nuvexa",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nuvexa",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "keywords": [
    "nuvexa",
    "herramientas-digitales",
    "privadas",
    "electron",
    "pdf",
    "qr",
    "images"
  ],
  "author": "Ignacio Gatti",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-installer-windows": "^3.0.0",
    "sharp": "^0.35.4",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "jszip": "^3.10.2",
    "libheif-js": "^1.23.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qr-code-styling": "^1.9.2",
    "tesseract.js": "^7.0.0"
  }
}
